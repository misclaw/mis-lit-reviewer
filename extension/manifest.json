{
  "manifest_version": 3,
  "name": "Paper Trails Bridge",
  "version": "0.5.0",
  "description": "Bridges searches on Google Scholar (Labs), Asta, Paper Digest, and SciSpace into Paper Trails — the Backward · Main · Forward IS literature review workbench.",
  "browser_specific_settings": {
    "gecko": {
      "id": "paper-trails-bridge@misclaw.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://asta.allen.ai/*",
        "https://www.paperdigest.org/*",
        "https://paperdigest.org/*",
        "https://scispace.com/*",
        "https://typeset.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mis-lit-reviewer.misclaw.app/*",
        "http://localhost:5173/*"
      ],
      "js": ["presence.js"],
      "run_at": "document_start"
    }
  ]
}
